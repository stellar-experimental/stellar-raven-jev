# stellar-raven-jev credentials. Copy to .env, fill in values, and keep it private (mode 0600).
# Point JEV_ENV_FILE at the file to run the CLI from any directory.

# --- Sources (read-only) --------------------------------------------------------
LUMENLOOP_API_KEY=
ALGOLIA_APPLICATION_ID_DOCS=
ALGOLIA_API_KEY_DOCS=
ALGOLIA_APPLICATION_ID_SITE=
ALGOLIA_API_KEY_SITE=
# Optional: a Stellar Scout (stellarlight.xyz) partner key, sent as a bearer token. Without it,
# Scout's public limit of 60 research requests per minute per IP caps this host at about four
# questions per minute.
STELLAR_LIGHT_API_KEY=

# --- Jev providers ----------------------------------------------------------------
# Configure one or more. Every configured provider joins the chain in this order:
# cloudflare, then typesafe, then openrouter. A call moves to the next provider when one
# is rate limited (429/529), refuses payment (402), or rejects its credentials (401/403).
# Set JEV_PROVIDERS to change the order or to use a subset.
# JEV_PROVIDERS=cloudflare,typesafe,openrouter
# Each provider has a send budget per minute on this host, shared by every search. A call moves to
# the next provider when the first one's budget is spent. Defaults: cloudflare 900, typesafe 3600,
# openrouter 3600. Replace any of them here.
# JEV_PROVIDER_RPM=cloudflare=900,typesafe=3600,openrouter=3600

# --- Host capacity ------------------------------------------------------------------
# Searches that may run at once on this host (default 6). Another search waits up to 60 s for a
# slot, then prints status "busy" and exits 3 without spending.
# JEV_MAX_SEARCHES=6
# Questions that may fetch from one source host at once (HOST=N,...). Unset hosts are not capped.
# JEV_SOURCE_SLOTS=stellarlight.xyz=3

# 1. Cloudflare Workers AI. Set CLOUDFLARE_API_TOKEN, or name an existing Wrangler OAuth
#    profile in JEV_CLOUDFLARE_AUTH_PROFILE.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
JEV_CLOUDFLARE_AUTH_PROFILE=
#    Use a gateway with no stored TypeSafe key so Jev bills through Unified Billing.
#    Defaults to `default`.
JEV_GATEWAY_ID=

# 2. TypeSafe's own API (https://api.typesafe.ai), billed to the TypeSafe account.
TYPESAFE_AI_API_KEY=

# 3. OpenRouter's TypeSafe-compatible endpoint (model ~typesafe/jev-latest), billed to
#    OpenRouter credits.
OPENROUTER_API_KEY=
