# Read-only source credentials. Keep actual values in .env (mode 0600).
LUMENLOOP_API_KEY=
ALGOLIA_APPLICATION_ID_DOCS=
ALGOLIA_API_KEY_DOCS=
ALGOLIA_APPLICATION_ID_SITE=
ALGOLIA_API_KEY_SITE=
# Jev runs through Cloudflare. Set a static API token or an existing Wrangler OAuth profile.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
JEV_CLOUDFLARE_AUTH_PROFILE=
# Use a gateway with no stored TypeSafe key so Jev bills through Unified Billing. Defaults to `default`.
JEV_GATEWAY_ID=
