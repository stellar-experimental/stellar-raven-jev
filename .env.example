# stellar-raven-jev settings. Copy to .env, fill in values, and keep the file private (mode 0600).
# The CLI reads .env from the working directory or a parent. To run from any directory, set
# JEV_ENV_FILE (or pass --env-file) to the absolute path of this file. Variables that are already
# set in the environment win over the file. An empty value keeps the default.
# See docs/configuration.md for how each setting works.

# --- Spending and output ----------------------------------------------------------
# Jev spending limit in USD for one call. Live calls need a value above 0 and at most 100.
JEV_BUDGET_USD=
# Parent directory for run folders. Default: runs (relative to the working directory).
# JEV_OUTPUT_DIR=

# --- Sources (read-only) ----------------------------------------------------------
LUMENLOOP_API_KEY=
ALGOLIA_APPLICATION_ID_DOCS=
ALGOLIA_API_KEY_DOCS=
ALGOLIA_APPLICATION_ID_SITE=
ALGOLIA_API_KEY_SITE=
# Optional Stellar Scout partner key, sent as a bearer token.
STELLAR_LIGHT_API_KEY=

# --- Jev providers ----------------------------------------------------------------
# Configure at least one provider. Configured providers form a failover chain.
# Chain order. Default: cloudflare,typesafe,openrouter (only the configured ones).
# JEV_PROVIDERS=cloudflare,typesafe,openrouter
# Requests per minute that each provider may receive from this host.
# JEV_PROVIDER_RPM=cloudflare=400,typesafe=3600,openrouter=3600

# Cloudflare Workers AI: the account ID, and a CLOUDFLARE_API_TOKEN or a Wrangler profile name.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
JEV_CLOUDFLARE_AUTH_PROFILE=
# Cloudflare AI Gateway ID. Default: default.
JEV_GATEWAY_ID=

# TypeSafe API key (https://api.typesafe.ai).
TYPESAFE_AI_API_KEY=

# OpenRouter API key.
OPENROUTER_API_KEY=

# --- Host capacity ----------------------------------------------------------------
# Searches that may run at once on this host. Default: 6.
# JEV_MAX_SEARCHES=6
# Days without activity before a run folder is removed automatically. 0 keeps all. Default: 7.
# JEV_RETAIN_DAYS=7
# Questions that may fetch from one source host at once, as HOST=N,... Replaces a host's default.
# JEV_SOURCE_SLOTS=example.org=2
# Folder of state that searches on this host share. Default: OUTPUT_DIR/.host.
# JEV_HOST_DIR=
