# Read-only source credentials. Keep actual values in .env (mode 0600).
LUMENLOOP_API_KEY=
ALGOLIA_APPLICATION_ID_DOCS=
ALGOLIA_API_KEY_DOCS=
ALGOLIA_APPLICATION_ID_SITE=
ALGOLIA_API_KEY_SITE=
# Existing authenticated Jev proxy, or use a direct TypeSafe key.
JEV_PROXY_URL=
JEV_PROXY_TOKEN=
TYPESAFE_API_KEY=
# Direct Cloudflare: set JEV_BACKEND=cloudflare and choose a static token or an existing Wrangler OAuth profile.
JEV_BACKEND=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
JEV_CLOUDFLARE_AUTH_PROFILE=
JEV_GATEWAY_ID=
